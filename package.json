{
  "name": "@waldrumpus/orb",
  "version": "0.5.0",
  "description": "Reusable utilities for TypeScript games",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "npm run build && tsc -p tests/tsconfig.json && node --test tests/*.test.mjs",
    "build": "tsc",
    "prepack": "npm run build",
    "start": "tsx src/main.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
